# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# New keys (Dashboard → Settings → API Keys) — preferred
# Use these if you see: unrecognized JWT kid <nil> for algorithm ES256
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy JWT keys (fallback only — can break Auth Admin with ES256 signing)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe Checkout (deposits + invoice Pay Now) — never commit real keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional override for Checkout success/cancel URLs
# NEXT_PUBLIC_SITE_URL=https://morton-mechanical.vercel.app
